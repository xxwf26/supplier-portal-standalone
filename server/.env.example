# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=3001

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=supplier_portal

# JWT（必须配置，禁止使用默认/示例值）
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 允许跨域访问的前端源（逗号分隔），不配置则使用内置开发默认值
# CORS_ORIGINS=http://localhost:5174,http://localhost:3001

# Upload（上传目录，相对路径基于 server 工作目录解析；建议生产用绝对路径）
UPLOAD_DIR=../uploads