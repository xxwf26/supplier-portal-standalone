# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=3001

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=supplier_portal

# JWT（必须配置，禁止使用默认/示例值）
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 登录账号（不配置则回退到默认 admin/admin123、viewer/viewer123，仅供本地开发）
# 生产务必配置。密码优先用 bcrypt 哈希：
#   node -e "console.log(require('bcryptjs').hashSync('你的密码',10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=            # 明文兜底（不推荐，配了 HASH 就忽略此项）
VIEWER_USERNAME=viewer
VIEWER_PASSWORD_HASH=
# VIEWER_PASSWORD=

# 允许跨域访问的前端源（逗号分隔），不配置则使用内置开发默认值
# CORS_ORIGINS=http://localhost:5174,http://localhost:3001

# Upload（上传目录，相对路径基于 server 工作目录解析；建议生产用绝对路径）
UPLOAD_DIR=../uploads

# AI（小红书笔记 AI 总结功能。走 Anthropic Messages 协议中转）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=deepseek-v4-pro
AI_MAX_TOKENS=4000
AI_TIMEOUT_MS=150000

# 图片 OCR（视觉模型，读小红书图上文字）。OpenAI 兼容端点 + 复用 AI_API_KEY。
AI_OCR_BASE_URL=https://tc-paperhub.diezhi.net/v1
AI_OCR_MODEL=qwen-vl-ocr